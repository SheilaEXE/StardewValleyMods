<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>HomeDialogues</AssemblyName>
    <RootNamespace>HomeDialogues</RootNamespace>
    <Version>1.0.0</Version>

    <Nullable>annotations</Nullable>
    <TargetFramework>net6.0</TargetFramework>

    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

  <Target Name="CopyModToStardewMods" AfterTargets="Build">
    <PropertyGroup>
      <StardewModsDir Condition="'$(StardewModsDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stardew Valley\Mods\</StardewModsDir>
      <HomeDialoguesRootDir>$(StardewModsDir)Home Dialogues\</HomeDialoguesRootDir>
      <ModDeployDir>$(HomeDialoguesRootDir)Home Dialogues\</ModDeployDir>
    </PropertyGroup>

    <MakeDir Directories="$(HomeDialoguesRootDir)" />
    <MakeDir Directories="$(ModDeployDir)" />

    <!-- Limpa APENAS arquivos que builds antigos podem ter colocado na pasta mãe:
         Mods\Home Dialogues\

         Isso não apaga:
         - Mods\Home Dialogues\Home Dialogues\i18n\
         - Mods\Home Dialogues\[CP] Home Dialogues\
    -->
    <Delete
      Files="$(HomeDialoguesRootDir)HomeDialogues.dll;$(HomeDialoguesRootDir)HomeDialogues.pdb;$(HomeDialoguesRootDir)HomeDialogues.deps.json;$(HomeDialoguesRootDir)manifest.json;$(HomeDialoguesRootDir)config.json;$(HomeDialoguesRootDir)README - dialog keys.txt"
      TreatErrorsAsWarnings="true" />

    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFiles="$(ModDeployDir)$(TargetFileName)"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pdb"
      DestinationFiles="$(ModDeployDir)$(AssemblyName).pdb"
      Condition="Exists('$(TargetDir)$(AssemblyName).pdb')"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="manifest.json"
      DestinationFiles="$(ModDeployDir)manifest.json"
      SkipUnchangedFiles="true" />

    <ItemGroup>
      <ReadmeFiles Include="*.txt" />
    </ItemGroup>

    <ItemGroup>
      <TranslationFiles Include="i18n\**\*.json" />
    </ItemGroup>

    <!-- Diálogos são traduções do mod C#; cada idioma tem seu próprio JSON em i18n\. -->
    <Copy
      SourceFiles="@(TranslationFiles)"
      DestinationFiles="@(TranslationFiles->'$(ModDeployDir)i18n\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="@(ReadmeFiles)"
      DestinationFiles="@(ReadmeFiles->'$(ModDeployDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <!-- Se você colocar a pasta [CP] Home Dialogues dentro da pasta do projeto,
         o build também copia ela para a pasta mãe correta.
         Se ela só existir dentro de Mods, nada será mexido. -->
    <ItemGroup Condition="Exists('[CP] Home Dialogues')">
      <ContentPackFiles Include="[CP] Home Dialogues\**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(ContentPackFiles)"
      DestinationFiles="@(ContentPackFiles->'$(HomeDialoguesRootDir)[CP] Home Dialogues\%(RecursiveDir)%(Filename)%(Extension)')"
      Condition="Exists('[CP] Home Dialogues')"
      SkipUnchangedFiles="true" />

    <Message Importance="high" Text="Home Dialogues copiado para: $(ModDeployDir)" />
    <Message Importance="high" Text="A pasta CP esperada é: $(HomeDialoguesRootDir)[CP] Home Dialogues\" />
  </Target>

</Project>
